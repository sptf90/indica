MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Sessão (HMAC) — gere um valor longo e aleatório
AUTH_SECRET=change-me-to-a-long-random-string

# Protege POST /api/cron/close-expired (header Authorization: Bearer …)
CRON_SECRET=change-me-cron-secret

# Places API (New) — chave server-side (não exponha no client)
# Ative "Places API (New)" no Google Cloud e restrinja por IP/referrer se possível.
GOOGLE_PLACES_API_KEY=
