MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Sessão (HMAC) — gere um valor longo e aleatório
AUTH_SECRET=change-me-to-a-long-random-string

# Protege POST /api/cron/close-expired (header Authorization: Bearer …)
CRON_SECRET=change-me-cron-secret

# Mapa Leaflet/OpenStreetMap: funciona sem chave ou conta de faturamento.
# Opcionais: altere o provedor de mapas sem modificar o código.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
