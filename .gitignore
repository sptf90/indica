# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.pem
*.deb
*:Zone.Identifier
*.log

# user uploads (keep folder)
/public/uploads/*
!/public/uploads/.gitkeep

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env / secrets — never commit real credentials
.env
.env.*
!.env.example
*.secret
*.secrets
secrets/
.secrets/

# local npm registry / SSL overrides (machine-specific)
.npmrc

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cursor + Impeccable skill (downloaded binary, local hooks)
.cursor/

# Impeccable generated / per-developer — keep DESIGN.md sidecar
.impeccable/*
!.impeccable/design.json
!.impeccable/config.json
